{
  "expo": {
    "name": "covelet",
    "slug": "covelet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "covelet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.hitha.covelet",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#F0EBE0"
      },
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F0EBE0",
          "dark": {
            "backgroundColor": "#F0EBE0"
          }
        }
      ],
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "origin": "https://covelet.com"
      },
      "eas": {
        "projectId": "202b9990-0b52-4a40-bd71-f314e65ddb2f"
      }
    },
    "ios": {
      "bundleIdentifier": "com.hitha.covelet"
    }
  }
}
